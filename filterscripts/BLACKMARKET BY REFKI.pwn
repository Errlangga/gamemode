CMD:buyarmor(playerid, params[])
{
	if(IsPlayerInRangeOfPoint(playerid, 10.0, 2724.01,-1421.65,16.25))
	{
    GivePlayerMoneyEx(playerid, -200000, "Anda telah membeli senjata jenis ak47", false, true);
    SetPlayerArmour(playerid, 100);
	}
	else SendClientMessage(playerid, 0xCECECEFF, "Anda tidak di toko senjata ilegal");

	return 1;
}

