	// SCIPRT NYA

CMD:listharga(playerid, params[])
{
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buyak47 Harga = 500k");
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buymp5 Harga = 500k");
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buydesert Harga = 120k");
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buysg Harga = 600k");
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buyuzi Harga = 500k");
    SendClientMessage(playerid, 0xD900D3C8, "{A7FC00}/buyarmor Harga = 200k");
        return 1;
	}
CMD:buyak47(playerid, params[])
{
	if(IsPlayerInRangeOfPoint(playerid, 10.0, 2724.01,-1421.65,16.25))
	{
    GivePlayerMoneyEx(playerid, -500000, "Anda telah membeli senjata jenis ak47", false, true);
    GivePlayerWeapon(playerid, 30, 200);
	}
	else SendClientMessage(playerid, 0xCECECEFF, "Anda tidak di toko senjata ilegal");

	return 1;
}
CMD:buydesert(playerid, params[])
{
	if(IsPlayerInRangeOfPoint(playerid, 10.0, 2724.01,-1421.65,16.25))
	{
    GivePlayerMoneyEx(playerid, -120000, "Anda telah membeli senjata jenis ak47", false, true);
    GivePlayerWeapon(playerid, 24, 120);
	}
	else SendClientMessage(playerid, 0xCECECEFF, "Anda tidak di toko senjata ilegal");

	return 1;
}
